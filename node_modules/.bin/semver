#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*) basedir=`cygpath -w "$basedir"`;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/var/www/html/python/EchoSphere/node_modules/semver/bin/node_modules:/var/www/html/python/EchoSphere/node_modules/semver/node_modules:/var/www/html/python/EchoSphere/node_modules:/var/www/html/python/node_modules:/var/www/html/node_modules:/var/www/node_modules:/var/node_modules:/node_modules:/var/www/html/python/EchoSphere/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/var/www/html/python/EchoSphere/node_modules/semver/bin/node_modules:/var/www/html/python/EchoSphere/node_modules/semver/node_modules:/var/www/html/python/EchoSphere/node_modules:/var/www/html/python/node_modules:/var/www/html/node_modules:/var/www/node_modules:/var/node_modules:/node_modules:/var/www/html/python/EchoSphere/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../semver/bin/semver.js" "$@"
else
  exec node  "$basedir/../semver/bin/semver.js" "$@"
fi
