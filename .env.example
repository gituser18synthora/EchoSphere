# ── Application ──────────────────────────────────────────────
APP_ENV=development
APP_NAME=EchoSphere
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated origins allowed by CORS (frontend dev server)
CORS_ORIGINS=http://localhost:5199

# ── Security ─────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ── MySQL (structured / relational data) ─────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=voice_bot
MYSQL_USER=
MYSQL_PASSWORD=

# ── MongoDB (documents: transcripts, voice payloads) ─────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=voice_bot

# ── Redis (VoiceBot engine config cache) ─────────────────────
REDIS_URL=redis://localhost:6379

# ── Data-safety switches ─────────────────────────────────────
# When false every hard-delete request is rejected; deletes archive instead.
ALLOW_HARD_DELETE=false
# Run `alembic upgrade head` automatically at API startup.
AUTO_RUN_MIGRATIONS=false
# Run the idempotent base seed (roles, permissions, super admin…) at startup.
ENABLE_DATABASE_SEED=true

# ── Initial Super Admin (used by the seed; change after first login) ──
SUPERADMIN_EMAIL=admin@aurexion.com
SUPERADMIN_NAME=Platform Admin
SUPERADMIN_PASSWORD=

# ── VoiceBot engine (existing) ────────────────────────────────
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=VoicebotDB

# ── PostgreSQL + pgvector (knowledge plane) ──────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=echosphere_knowledge
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_POOL_SIZE=10

PGVECTOR_DISTANCE_METRIC=cosine
PGVECTOR_HNSW_M=16
PGVECTOR_HNSW_EF_CONSTRUCTION=64
PGVECTOR_HNSW_EF_SEARCH=100

# ── Knowledge / RAG ──────────────────────────────────────────
# Providers: openai (production) | mock (offline development/tests)
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY_REFERENCE=env:OPENAI_API_KEY
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
KNOWLEDGE_UPLOAD_DIR=storage/knowledge
KNOWLEDGE_MAX_FILE_MB=25
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.35
RETRIEVAL_USE_RERANKER=false
ENABLE_OCR_FALLBACK=true

# ── Speech / LLM provider defaults (per-bot overrides in DB) ─
STT_PROVIDER=openai
STT_API_KEY_REFERENCE=env:OPENAI_API_KEY
STT_MODEL=whisper-1
TTS_PROVIDER=openai
TTS_API_KEY_REFERENCE=env:OPENAI_API_KEY
TTS_MODEL=tts-1
TTS_VOICE=alloy
LLM_PROVIDER=openai
LLM_API_KEY_REFERENCE=env:OPENAI_API_KEY
LLM_MODEL=gpt-4o-mini
# Raw provider keys referenced above (never committed):
OPENAI_API_KEY=

# ── MCP server ───────────────────────────────────────────────
MCP_ENABLED=true
MCP_HOST=0.0.0.0
MCP_PORT=8020

# ── Voice runtime ────────────────────────────────────────────
VOICE_WORKER_HOST=0.0.0.0
VOICE_WORKER_PORT=8015
VOICE_WORKER_CONCURRENCY=20
VOICE_SESSION_TIMEOUT=900
MAX_CALL_DURATION=3600
DEFAULT_SILENCE_TIMEOUT=12

# ── Telephony ────────────────────────────────────────────────
FREESWITCH_HOST=127.0.0.1
FREESWITCH_PORT=8021
FREESWITCH_PASSWORD_REFERENCE=env:FREESWITCH_PASSWORD
FREESWITCH_PASSWORD=
TELEPHONY_WEBHOOK_SECRET_REFERENCE=env:TELEPHONY_WEBHOOK_SECRET
TELEPHONY_WEBHOOK_SECRET=

# ── Background / events (reserved; ingestion uses the DB queue) ─
KAFKA_BOOTSTRAP_SERVERS=
