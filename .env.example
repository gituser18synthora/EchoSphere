# EchoSphere — environment template. Copy to `.env` in the project root and
# fill in the blanks. ONE .env is shared by every process:
#
#   Platform API      env/bin/uvicorn backend.main:app --port 8000
#   Voice runtime     env/bin/uvicorn voice_runtime.app:app --port 8015
#   Ingestion worker  env/bin/python -m backend.workers.ingestion   (optional; embedded in API by default)
#   MCP server        env/bin/python -m backend.mcp_server.server   (optional)
#
# Both services validate mandatory variables at startup and refuse to boot
# with a clear error when one is missing (see shared/config.py).
# Never commit a real .env — only this example file is tracked.

# ── Application ──────────────────────────────────────────────
APP_ENV=development
APP_NAME=EchoSphere
# Bind address/port the API is served on (keep in sync with your uvicorn args).
API_HOST=0.0.0.0
API_PORT=9001
# Comma-separated origins allowed by CORS (frontend dev server).
CORS_ORIGINS=http://localhost:5199

# ── Security (REQUIRED for the API) ──────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ── MySQL — control plane (REQUIRED: user + password) ────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=voice_bot
MYSQL_USER=
MYSQL_PASSWORD=

# ── MongoDB — transcripts & voice events (REQUIRED) ──────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=voice_bot

# ── Redis — voice-session handoff & config caches (REQUIRED) ─
# The API writes trusted session→tenant/bot mappings here; the voice runtime
# only accepts WebSocket connections whose session id resolves in Redis.
REDIS_URL=redis://localhost:6379

# ── Data-safety switches ─────────────────────────────────────
# When false every hard-delete request is rejected; deletes archive instead.
ALLOW_HARD_DELETE=false
# Run `alembic upgrade head` automatically at API startup.
AUTO_RUN_MIGRATIONS=false
# Run the idempotent base seed (roles, permissions, super admin…) at startup.
ENABLE_DATABASE_SEED=true

# ── Initial Super Admin (REQUIRED while ENABLE_DATABASE_SEED=true) ──
SUPERADMIN_EMAIL=admin@aurexion.com
SUPERADMIN_NAME=Platform Admin
SUPERADMIN_PASSWORD=

# ── PostgreSQL + pgvector — knowledge plane (REQUIRED: user + password) ──
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=echosphere_knowledge
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20

PGVECTOR_DISTANCE_METRIC=cosine
PGVECTOR_HNSW_M=16
PGVECTOR_HNSW_EF_CONSTRUCTION=64
PGVECTOR_HNSW_EF_SEARCH=100

# ── Knowledge / RAG ──────────────────────────────────────────
# Embedding providers: openai (production) | mock (offline development/tests).
EMBEDDING_PROVIDER=mock
EMBEDDING_API_KEY_REFERENCE=env:OPENAI_API_KEY
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=64
KNOWLEDGE_UPLOAD_DIR=storage/knowledge
KNOWLEDGE_MAX_FILE_MB=25
RETRIEVAL_TOP_K=6
RETRIEVAL_CANDIDATE_K=24
RETRIEVAL_RERANK_K=12
RETRIEVAL_MIN_SCORE=0.35
RETRIEVAL_HYBRID_VECTOR_WEIGHT=0.6
RETRIEVAL_HYBRID_KEYWORD_WEIGHT=0.4
# Requires `pip install sentence-transformers` before enabling.
RETRIEVAL_USE_RERANKER=false
RETRIEVAL_TS_CONFIG=english
# OCR fallback for scanned PDFs/images (requires tesseract-ocr installed).
ENABLE_OCR_FALLBACK=true
OCR_MIN_PAGE_CHARS=120
# Ingestion queue (Postgres-backed). The worker runs inside the API process by
# default; set INGESTION_WORKER_EMBEDDED=false when running dedicated workers
# via `python -m backend.workers.ingestion`.
INGESTION_WORKER_EMBEDDED=true
INGESTION_WORKER_POLL_SECONDS=2.0
INGESTION_MAX_ATTEMPTS=3

# ── Speech / LLM platform defaults (per-bot overrides live in DB) ──
# Providers — stt: openai|deepgram|assemblyai|sarvam|mock
#             tts: openai|elevenlabs|azure|google|sarvam|mock
#             llm: openai|anthropic|google|mock
# *_API_KEY_REFERENCE points at the env var holding the raw key (env:VAR).
STT_PROVIDER=openai
STT_API_KEY_REFERENCE=env:OPENAI_API_KEY
STT_MODEL=whisper-1
TTS_PROVIDER=openai
TTS_API_KEY_REFERENCE=env:OPENAI_API_KEY
TTS_MODEL=tts-1
TTS_VOICE=alloy
LLM_PROVIDER=openai
LLM_API_KEY_REFERENCE=env:OPENAI_API_KEY
LLM_MODEL=gpt-4o-mini

# ── Raw provider secrets (OPTIONAL — set only what you use) ──
# Referenced through the *_API_KEY_REFERENCE values above or through per-bot
# provider configs in the database (references only; raw keys never in DB).
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# DEEPGRAM_API_KEY=
# ASSEMBLYAI_API_KEY=
SARVAM_API_KEY=
ELEVENLABS_API_KEY=
# AZURE_SPEECH_KEY=          # Azure TTS also needs config.extra["region"] per bot

# ── Outbound API connections (SSRF guard) ────────────────────
# Private/loopback targets are blocked unless explicitly allowed (dev/test).
API_CONNECT_ALLOW_PRIVATE=false
# Comma-separated host allowlist; empty = any public host.
API_CONNECT_ALLOWED_HOSTS=
API_CONNECT_MAX_RESPONSE_KB=64

# ── MCP server (optional process) ────────────────────────────
MCP_ENABLED=true
MCP_HOST=0.0.0.0
MCP_PORT=9003

# ── Voice runtime ────────────────────────────────────────────
# VOICE_WORKER_PORT must match the port `voice_runtime.app` is started on:
# the API returns it to browser clients when issuing voice sessions.
VOICE_WORKER_HOST=0.0.0.0
VOICE_WORKER_PORT=9002
# Max concurrent calls per worker process; new calls are rejected (4429) above it.
VOICE_WORKER_CONCURRENCY=20
# Redis TTL for issued sessions; also the transport idle timeout (seconds).
VOICE_SESSION_TIMEOUT=900
MAX_CALL_DURATION=3600
DEFAULT_SILENCE_TIMEOUT=12

# ── Telephony (OPTIONAL — required only for phone/SIP channels) ──
FREESWITCH_HOST=127.0.0.1
FREESWITCH_PORT=9004
FREESWITCH_PASSWORD_REFERENCE=env:FREESWITCH_PASSWORD
# FREESWITCH_PASSWORD=
TELEPHONY_WEBHOOK_SECRET_REFERENCE=env:TELEPHONY_WEBHOOK_SECRET
# Twilio: the account auth token (signature checks). Others: HMAC webhook secret.
# TELEPHONY_WEBHOOK_SECRET=

# ── Channel credentials (OPTIONAL) ───────────────────────────
# Per-bot channels store only env: references to these — raw secrets never hit
# the database. The reference names below are examples; a channel config may
# point at any env var you define here. Set only the ones your channels use.
# TWILIO_AUTH_TOKEN=            # voice/SMS via Twilio (authTokenReference/apiKeyReference)
# WHATSAPP_API_KEY=             # WhatsApp Cloud API access token (apiKeyReference)
# WHATSAPP_WEBHOOK_SECRET=      # WhatsApp inbound webhook verify token + HMAC (webhookSecretReference)
# SMS_API_KEY=                  # SMS provider API key (apiKeyReference)
# MOBILE_SDK_KEY=               # Mobile SDK key (apiKeyReference)
