   "version": 3,
   "status": "approved",
   "nodes": [
    {
     "x": 40,
     "y": 40,
     "id": "n_start",
     "kind": "start",
     "label": "Outbound call connected"
    },
    {
     "x": 40,
     "y": 150,
     "id": "n_push",
     "kind": "intent",
     "label": "Rung 1: push",
     "config": {
      "prompt": "Aap call par rehte hue hi UPI ke through abhi payment complete kar dijiye, taaki hum turant aapki help kar sakein aur payment se related koi dikkat na ho. Saath hi aapka profile bhi turant update ho jayega. Kya aap abhi payment karenge?"
     }
    },
    {
     "x": 40,
     "y": 260,
     "id": "n_benefits",
     "kind": "intent",
     "label": "Rung 2: benefits",
     "config": {
      "prompt": "Ek achhi baat bata dun — agar aap abhi call par payment complete karte hain, toh aapki credit limit gradually ₹50,000 tak badhne ke high chances hain. BHIM UPI se payment par ₹40 tak ka discount mil sakta hai, aur Paytm UPI se ₹10 se ₹300 tak ka cashback aur mahine mein ek baar ₹2,000 tak ka Paytm voucher milne ka chance bhi hai. Toh kya aap abhi UPI se payment complete karenge?"
     }
    },
    {
     "x": 40,
     "y": 370,
     "id": "n_promise_funds",
     "kind": "intent",
     "label": "Rung 3: promise_funds",
     "config": {
      "prompt": "System records ke hisaab se pehle bhi aapse payment ke baare mein baat hui thi aur aapne payment ka promise kiya tha, lekin abhi tak payment receive nahi hui hai. Aapne pehle kai baar bina kisi extra charges ke time par repay kiya hai. Aap apni savings se, ya kisi friend ya family se arrange karke bhi payment kar sakte hain — isse aapko koi penalty nahi deni hogi. Kya aap payment ka intezaam kar lenge?"
     }
    },
    {
     "x": 40,
     "y": 480,
     "id": "n_penalty",
     "kind": "intent",
     "label": "Rung 4: penalty",
     "config": {
      "prompt": "Main aapko inform karna chahta hun ki due date par payment na karne se penalty daily badhti hai aur extra charges lagte rehte hain. Extra charges avoid karne ke liye abhi payment complete kar dijiye. Kya aap abhi payment karenge?"
     }
    },
    {
     "x": 40,
     "y": 590,
     "id": "n_cibil",
     "kind": "intent",
     "label": "Rung 5: cibil",
     "config": {
      "prompt": "Ek aur zaroori baat — time par repayment na karne se aapka CIBIL score impact hota hai, aur aaj ke time mein CIBIL bahut important hai. Emergency mein — jaise medical ya family needs — loan ki zarurat kabhi bhi pad sakti hai. Agar CIBIL low hoga toh loan milne mein dikkat ho sakti hai, ya interest rate kaafi high ho sakta hai. Isliye request hai ki abhi payment complete kar dijiye aur apna CIBIL safe rakhiye. Kya aap payment karenge?"
     }
    },
    {
     "x": 360,
     "y": 150,
     "id": "n_ptype",
     "kind": "ask",
     "label": "Full or partial payment",
     "config": {
      "question": "Bahut achha! Kya aap apna poora overdue amount pay karenge, ya partial payment karenge?",
      "synonyms": {
       "full": [
        "poora",
        "pura",
        "puri",
        "complete",
        "whole",
        "saara",
        "sara",
        "full",
        "पूरा",
        "पूरी",
        "सारा",
        "पूर्ण"
       ],
       "partial": [
        "partial",
        "part payment",
        "aadha",
        "adha",
        "half",
        "thoda",
        "installment",
        "instalment",
        "kisht",
        "आधा",
        "आधी",
        "थोड़ा",
        "थोड़ी",
        "किस्त",
        "किश्त"
       ]
      },
      "variable": "payment_type",
      "entityType": "list"
     }
    },
    {
     "x": 360,
     "y": 260,
     "id": "n_mop",
     "kind": "ask",
     "label": "Mode of payment",
     "config": {
      "question": "Kaunse madhyam se aapka payment hoga – Debit Card ya UPI?",
      "synonyms": {
       "UPI": [
        "upi",
        "bhim",
        "paytm",
        "gpay",
        "google pay",
        "phonepe",
        "phone pe",
        "qr",
        "यूपीआई",
        "यू पी आई",
        "भीम",
        "पेटीएम",
        "फोनपे",
        "फोन पे",
        "गूगल पे",
        "क्यूआर"
       ],
       "Debit Card": [
        "debit",
        "card",
        "atm",
        "डेबिट",
        "कार्ड",
        "एटीएम"
       ]
      },
      "variable": "payment_method",
      "entityType": "list"
     }
    },
    {
     "x": 360,
     "y": 370,
     "id": "n_guide",
     "kind": "message",
     "label": "Payment guidance",
     "config": {
      "text": "Dhanyavaad! Kripya mPokket app kholkar apna payment abhi complete kar dijiye. BHIM UPI ya Paytm UPI se payment karne par discount ya cashback milne ke chances bhi hain. Payment complete hote hi aapka profile turant update ho jayega aur koi extra penalty charges nahi lagenge. Main call par kabhi card number, PIN ya OTP nahi maangta — yeh details kisi ke saath share na karein."
     }
    },
    {
     "x": 360,
     "y": 480,
     "id": "n_close",
     "kind": "end",
     "label": "Close call",
     "config": {
      "text": "mPokket mein samay dene ke liye dhanyavaad, aapka din shubh ho!"
     }
    },
    {
     "x": 40,
     "y": 700,
     "id": "n_refuse_end",
     "kind": "end",
     "label": "Refusal close",
     "config": {
      "text": "Theek hai, main aapki baat note kar raha hun. Kripya yaad rakhiye — jitni jaldi aap payment complete karenge, utna hi aap extra penalty aur CIBIL impact se bachenge. Kripya aaj hi mPokket app se apna payment complete karne ki koshish kijiye. mPokket mein samay dene ke liye dhanyavaad, aapka din shubh ho!"
     }
    },
    {
     "x": 660,
     "y": 150,
     "id": "n_callback",
     "kind": "end",
     "label": "Callback close",
     "config": {
      "text": "Koi baat nahi, hum aapko baad mein call kar lenge. Kripya jitni jaldi ho sake mPokket app se apna payment complete kar dijiye, taaki koi extra charges na lagen. Dhanyavaad, aapka din shubh ho!"
     }
    },
    {
     "x": 660,
     "y": 260,
     "id": "n_wrong",
     "kind": "end",
     "label": "Wrong person close",
     "config": {
      "text": "Maaf kijiye, lagta hai yeh call galat number par lag gayi. Aapka samay lene ke liye khed hai. Dhanyavaad, aapka din shubh ho!"
     }
    },
    {
     "x": 660,
     "y": 370,
     "id": "n_paid",
     "kind": "handover",
     "label": "Already paid — verify",
     "config": {
      "text": "Agar aapne payment already complete kar di hai, toh dhanyavaad! Main aapko hamare agent se connect kar raha hun jo aapki payment verify kar denge. Kripya line par bane rahiye."
     }
    },
    {
     "x": 660,
     "y": 480,
     "id": "n_agent",
     "kind": "handover",
     "label": "Agent handover",
     "config": {
      "text": "Main aapko hamare ek agent se connect kar raha hun. Kripya line par bane rahiye."
     }
    },
    {
     "x": 660,
     "y": 590,
     "id": "n_hardship",
     "kind": "intent",
     "label": "Financial or medical hardship",
     "config": {
      "prompt": "Main aapki baat samajh raha hun. Aapki financial ya family situation ke liye mujhe afsos hai. Main abhi payment ke liye aap par pressure nahi daalunga. Kya aap chahenge ki hum baad mein baat karein, ya main aapko support agent se connect karun?"
     }
    },
    {
     "x": 920,
     "y": 590,
     "id": "n_hardship_close",
     "kind": "end",
     "label": "Hardship — respectful close",
     "config": {
      "text": "Theek hai, main samajh gaya hun. Aap pehle apni zaroori needs ka dhyan rakhiye. Jab aapke liye possible ho, mPokket app mein repayment options check kar sakte hain. Dhanyavaad, aapka din shubh ho."
     }
    }
