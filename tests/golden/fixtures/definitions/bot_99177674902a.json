      "operator": "contains",
      "variable": "deny_reason"
     }
    },
    {
     "x": 1080,
     "y": 170,
     "id": "n_cond_r_repair",
     "kind": "condition",
     "label": "reason: repair?",
     "config": {
      "value": "repair",
      "operator": "contains",
      "variable": "deny_reason"
     }
    },
    {
     "x": 1340,
     "y": 170,
     "id": "n_cond_r_price",
     "kind": "condition",
     "label": "reason: price?",
