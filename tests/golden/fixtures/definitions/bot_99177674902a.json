     "label": "Call starts"
    },
    {
     "x": 300,
     "y": 40,
     "id": "n_ask_bid",
     "kind": "ask",
     "label": "Confirm booking ID",
     "config": {
      "pattern": "(?:BK[-\\s]?)?([0-9]{4,10})",
      "question": "Could you please confirm the booking ID for the reservation, as shown in your OYO manager app?",
      "variable": "booking_id",
      "entityType": "text"
     }
    },
    {
     "x": 560,
     "y": 40,
     "id": "n_api_booking",
     "kind": "api",
     "label": "Booking Details API",
     "config": {
      "connection": "OYO Booking Details"
     }
    },
    {
     "x": 820,
     "y": 40,
     "id": "n_intent_pm",
     "kind": "intent",
     "label": "Will you honor?",
     "config": {
      "prompt": "Thank you. Could you please confirm whether this booking will be honored for check-in?"
     }
    },
    {
     "x": 1080,
     "y": 40,
     "id": "n_ask_reason",
     "kind": "ask",
     "label": "Ask deny reason",
     "config": {
      "question": "I understand. Could you please help me understand the reason for declining the booking?",
      "variable": "deny_reason",
      "entityType": "text"
     }
    },
    {
     "x": 1340,
     "y": 40,
     "id": "n_cond_r_overbook",
     "kind": "condition",
     "label": "reason: overbook?",
     "config": {
      "value": "overbook",
      "operator": "contains",
      "variable": "deny_reason"
     }
    },
    {
     "x": 40,
     "y": 170,
     "id": "n_cond_r_full",
     "kind": "condition",
     "label": "reason: full?",
     "config": {
      "value": "full",
      "operator": "contains",
      "variable": "deny_reason"
     }
    },
    {
     "x": 300,
     "y": 170,
     "id": "n_cond_r_noroom",
     "kind": "condition",
     "label": "reason: no room?",
     "config": {
      "value": "no room",
      "operator": "contains",
      "variable": "deny_reason"
     }
    },
    {
     "x": 560,
     "y": 170,
     "id": "n_cond_r_mnt",
     "kind": "condition",
     "label": "reason: maintenance?",
     "config": {
      "value": "maintenance",
      "operator": "contains",
      "variable": "deny_reason"
     }
    },
    {
     "x": 820,
     "y": 170,
     "id": "n_cond_r_renov",
     "kind": "condition",
     "label": "reason: renovation?",
     "config": {
