 "workflows": [
  {
   "id": "wf_99a51c143517",
   "name": "OYO booking support journey",
   "version": 9,
   "status": "approved",
   "nodes": [
    {
     "x": 40,
     "y": 40,
     "id": "n_start",
     "kind": "start",
     "label": "Call starts"
    },
    {
     "x": 300,
     "y": 40,
     "id": "n_ask_booking",
     "kind": "ask",
     "label": "Ask booking ID",
     "config": {
      "pattern": "(?<![0-9])(?:BK[-\\s]?)?([0-9]{6})(?![0-9])",
      "question": "I can help you with that. Please say your six-digit booking ID slowly, one digit at a time.",
      "variable": "booking_id",
      "entityType": "text"
     }
    },
    {
     "x": 560,
     "y": 40,
     "id": "n_ask_name",
     "kind": "ask",
     "label": "Ask guest name",
     "config": {
      "question": "Thank you. For verification, may I know the guest name on this booking?",
      "variable": "guest_name",
      "entityType": "text"
     }
    },
    {
     "x": 820,
     "y": 40,
     "id": "n_api_verify",
     "kind": "api",
     "label": "Customer Verification API",
     "config": {
      "connection": "OYO Customer Verification"
     }
    },
    {
     "x": 1080,
     "y": 40,
     "id": "n_msg_verify_failed",
     "kind": "message",
     "label": "Verification failed",
     "config": {
      "text": "I'm sorry, I could not verify these details against the booking, so I can't share any booking information on this call. Let me connect you to a support executive for further help."
     }
    },
    {
     "x": 1340,
     "y": 40,
     "id": "n_api_ivr_sup",
     "kind": "api",
     "label": "IVR Transfer API",
     "config": {
      "connection": "OYO IVR Transfer"
     }
    },
    {
     "x": 40,
     "y": 170,
     "id": "n_handover_support",
     "kind": "handover",
     "label": "Transfer to support",
     "config": {
      "text": "Please stay on the line while I transfer you to our support team.",
      "queue": "customer_support"
     }
    },
    {
     "x": 300,
     "y": 170,
     "id": "n_api_booking",
     "kind": "api",
     "label": "Booking Details API",
     "config": {
      "connection": "OYO Booking Details"
     }
    },
    {
     "x": 560,
     "y": 170,
     "id": "n_msg_lookup_failed",
     "kind": "message",
     "label": "Lookup failed",
     "config": {
      "text": "I'm unable to retrieve this booking in our system right now."
     }
    },
    {
     "x": 820,
     "y": 170,
     "id": "n_cond_confirmed",
     "kind": "condition",
     "label": "Booking confirmed?",
     "config": {
      "value": "confirmed",
      "operator": "equals",
      "variable": "booking_status"
     }
    },
    {
     "x": 1080,
     "y": 170,
     "id": "n_msg_cancelled",
     "kind": "message",
     "label": "Booking cancelled",
     "config": {
      "text": "I've checked, and I'm sorry to share that this booking is showing as cancelled in our system, along with the cancellation date on record."
     }
    },
    {
     "x": 1340,
     "y": 170,
     "id": "n_intent_cancel",
     "kind": "intent",
     "label": "Did you cancel?",
     "config": {
      "prompt": "Did you cancel this booking yourself?"
     }
    },
    {
     "x": 40,
     "y": 300,
     "id": "n_msg_cancel_ack",
     "kind": "message",
     "label": "Cancel acknowledged",
     "config": {
      "text": "Understood. Since this booking stands cancelled, there is nothing pending on it. For a new booking, our support team or the OYO app can help you anytime.",
      "responseMode": "llm_grounded",
      "responseDirective": "Acknowledge that the caller confirmed they cancelled this booking themselves, so nothing is pending on it; mention the OYO app or support team can help with any new booking, and close politely."
     }
    },
    {
     "x": 300,
     "y": 300,
     "id": "n_msg_cancel_dispute",
     "kind": "message",
     "label": "Cancel dispute",
     "config": {
      "text": "I understand — you did not cancel this booking yourself. This needs immediate attention, so let me transfer you to a support executive who can investigate the cancellation right away."
     }
    },
    {
     "x": 560,
     "y": 300,
     "id": "n_api_ivr_esc",
     "kind": "api",
     "label": "IVR Transfer API (escalation)",
     "config": {
      "connection": "OYO IVR Transfer"
     }
    },
    {
     "x": 820,
     "y": 300,
     "id": "n_handover_esc",
     "kind": "handover",
     "label": "Transfer to escalations",
     "config": {
      "text": "Transferring you now — please stay on the line.",
      "queue": "escalations"
     }
    },
    {
     "x": 1080,
     "y": 300,
     "id": "n_hub",
     "kind": "intent",
     "label": "What would you like?",
     "config": {
      "prompt": "Great news — your booking is confirmed in our system. Would you like me to also confirm it directly with the property, hear your booking details, or get the booking voucher emailed to you?",
      "responseMode": "llm_grounded",
      "responseDirective": "Tell the caller their booking is confirmed in our system, then ask what they would like next, offering exactly these three options: confirming the booking directly with the property, hearing their booking details, or emailing the booking voucher. Never choose an option for them."
     }
    },
    {
     "x": 1340,
     "y": 300,
     "id": "n_msg_sysconfirm",
     "kind": "message",
     "label": "System confirmation",
     "config": {
      "text": "Perfect. Your booking is confirmed in our system, and you can proceed with your check-in without any issues.",
      "responseMode": "llm_grounded",
      "responseDirective": "Confirm that the booking is confirmed in our system and the caller can proceed with their check-in without any issues, then close warmly."
     }
    },
    {
     "x": 40,
     "y": 430,
     "id": "n_msg_details_exit",
     "kind": "message",
     "label": "Details answered from facts",
     "config": {
      "text": "I have your verified booking open — please tell me which detail you need.",
      "responseMode": "llm_grounded",
      "responseDirective": "Answer the caller's current booking question directly from the workflow-verified booking facts. For a single fact (hotel name, check-in or check-out date, occupancy, payment status, pending amount) state that value in the first sentence. For a broad details request give one concise spoken summary of the hotel, stay dates, occupancy and payment facts. Never recite a menu of what they may ask."
     }
    },
    {
     "x": 300,
     "y": 430,
     "id": "n_end_details",
     "kind": "end",
     "label": "End (details Q&A)"
    },
    {
     "x": 560,
     "y": 430,
     "id": "n_cond_email",
     "kind": "condition",
     "label": "Email on file?",
     "config": {
      "operator": "exists",
      "variable": "guest_email"
     }
    },
    {
     "x": 820,
     "y": 430,
     "id": "n_intent_email_confirm",
     "kind": "intent",
     "label": "Send to email on file?",
     "config": {
      "prompt": "I have the email address from your booking on file. Shall I send the booking voucher there?"
     }
    },
    {
     "x": 1080,
     "y": 430,
     "id": "n_ask_email",
     "kind": "ask",
     "label": "Ask email",
     "config": {
      "question": "Sure — could you please tell me the email address where I should send the voucher?",
      "variable": "email_address",
      "entityType": "email"
     }
    },
    {
     "x": 1340,
     "y": 430,
     "id": "n_api_voucher",
     "kind": "api",
     "label": "Booking Voucher API",
     "config": {
      "connection": "OYO Booking Voucher"
     }
    },
    {
     "x": 40,
     "y": 560,
     "id": "n_msg_voucher_ok",
     "kind": "message",
     "label": "Voucher sent",
     "config": {
      "text": "Done! I've emailed your booking voucher — it should reach your inbox within a few minutes.",
      "responseMode": "llm_grounded",
      "responseDirective": "Tell the caller their booking voucher was just emailed successfully (the send is system-verified) and should reach their inbox within a few minutes."
     }
    },
    {
     "x": 300,
     "y": 560,
     "id": "n_msg_voucher_fail",
     "kind": "message",
     "label": "Voucher failed",
     "config": {
      "text": "I'm sorry, I couldn't send the voucher right now. Our support team can email it to you manually."
     }
    },
    {
     "x": 560,
     "y": 560,
     "id": "n_hub_more",
     "kind": "intent",
     "label": "Anything else?",
     "config": {
      "prompt": "Is there anything else I can help you with today?"
     }
    },
    {
     "x": 820,
     "y": 560,
     "id": "n_msg_hold",
     "kind": "message",
     "label": "Hold for property check",
     "config": {
      "text": "Certainly. Let me quickly connect with the property and verify your booking status. Please stay on the line while I check."
     }
    },
    {
     "x": 1080,
     "y": 560,
     "id": "n_api_pm",
     "kind": "api",
     "label": "PM Verification Call",
     "config": {
      "connection": "OYO PM Verification Call"
     }
    },
    {
     "x": 1340,
     "y": 560,
     "id": "n_cond_pm_answered",
     "kind": "condition",
     "label": "PM unreachable?",
     "config": {
      "value": "no_answer",
      "operator": "equals",
      "variable": "pm_call_status"
     }
    },
    {
     "x": 40,
     "y": 690,
     "id": "n_cond_pm_honored",
     "kind": "condition",
     "label": "Booking honored?",
     "config": {
      "value": "true",
      "operator": "equals",
      "variable": "pm_booking_honored"
     }
    },
    {
     "x": 300,
     "y": 690,
     "id": "n_cond_res_alt",
     "kind": "condition",
     "label": "Alternate room?",
     "config": {
      "value": "alternate_room",
      "operator": "equals",
      "variable": "pm_resolution"
     }
    },
    {
     "x": 560,
     "y": 690,
     "id": "n_cond_res_comp",
     "kind": "condition",
     "label": "Compensation added?",
     "config": {
      "value": "compensation_added",
      "operator": "equals",
      "variable": "pm_resolution"
     }
    },
    {
     "x": 820,
     "y": 690,
     "id": "n_msg_pm_confirmed",
     "kind": "message",
     "label": "PM confirmed",
     "config": {
      "text": "Thank you for waiting. I have successfully confirmed your booking with the property. Your reservation is secured, and you can check in without any hassle."
     }
    },
    {
     "x": 1080,
     "y": 690,
     "id": "n_msg_alt_room",
     "kind": "message",
     "label": "Alternate room arranged",
     "config": {
      "text": "Good news! The property has arranged an alternate room for your stay, and your booking has been confirmed. You may proceed with your check-in."
     }
    },
    {
     "x": 1340,
     "y": 690,
     "id": "n_msg_comp_ok",
     "kind": "message",
     "label": "Confirmed after compensation",
     "config": {
      "text": "Good news! Your booking has been successfully confirmed with the property, and you can proceed with your check-in as planned."
     }
    },
    {
     "x": 40,
     "y": 820,
     "id": "n_cond_deny_ob",
     "kind": "condition",
     "label": "Denied: overbooked?",
     "config": {
      "value": "overbooked",
      "operator": "equals",
      "variable": "pm_deny_reason"
     }
    },
    {
     "x": 300,
     "y": 820,
     "id": "n_cond_deny_mnt",
     "kind": "condition",
     "label": "Denied: maintenance?",
     "config": {
      "value": "maintenance",
      "operator": "equals",
      "variable": "pm_deny_reason"
     }
    },
    {
     "x": 560,
     "y": 820,
     "id": "n_msg_overbooked",
     "kind": "message",
     "label": "Overbooked",
     "config": {
      "text": "Thank you for waiting. Unfortunately, the property is currently overbooked due to high demand and is unable to accommodate your reservation."
     }
    },
    {
     "x": 820,
     "y": 820,
     "id": "n_msg_maintenance",
     "kind": "message",
     "label": "Maintenance",
     "config": {
      "text": "Thank you for waiting. The property is currently undergoing maintenance and is unable to accommodate your booking."
     }
    },
    {
     "x": 1080,
     "y": 820,
     "id": "n_msg_price_denied",
     "kind": "message",
     "label": "Price denial",
     "config": {
      "text": "I sincerely apologize — despite our best efforts, the property is unable to accommodate this reservation."
     }
    },
    {
     "x": 1340,
     "y": 820,
     "id": "n_msg_stock",
     "kind": "message",
     "label": "Trying stock team",
     "config": {
      "text": "I was unable to reach the property manager at this time. Let me quickly validate your booking with our internal team instead. Please stay on the line."
     }
    },
    {
     "x": 40,
     "y": 950,
     "id": "n_api_stock",
     "kind": "api",
     "label": "Stock Team Call",
     "config": {
      "connection": "OYO Stock Team Call"
     }
    },
    {
     "x": 300,
     "y": 950,
     "id": "n_cond_stock",
     "kind": "condition",
     "label": "Stock confirmed?",
     "config": {
      "value": "confirmed",
      "operator": "equals",
      "variable": "stock_status"
     }
    },
    {
     "x": 560,
     "y": 950,
     "id": "n_msg_stock_ok",
     "kind": "message",
     "label": "Stock confirmed",
     "config": {
      "text": "Thank you for waiting. Our internal team has validated your reservation — your booking will be honored at check-in, and you may proceed with your stay as planned."
     }
    },
    {
     "x": 820,
     "y": 950,
     "id": "n_msg_stock_fail",
     "kind": "message",
     "label": "Stock could not confirm",
     "config": {
      "text": "I'm sorry — I could not get a confirmation from the property or our internal team at this moment."
     }
    },
    {
     "x": 1080,
     "y": 950,
     "id": "n_intent_shift",
     "kind": "intent",
     "label": "Offer shift",
     "config": {
      "prompt": "Would you like me to help arrange an alternate OYO property nearby with similar amenities?"
     }
    },
    {
     "x": 1340,
     "y": 950,
     "id": "n_api_alts",
     "kind": "api",
     "label": "Alternate Properties API",
     "config": {
      "connection": "OYO Alternate Properties"
     }
    },
    {
     "x": 40,
     "y": 1080,
     "id": "n_msg_no_alts",
     "kind": "message",
     "label": "No alternates",
     "config": {
      "text": "I'm sorry — I couldn't find an alternate OYO property nearby right now. Let me connect you to our support team to help you further."
     }
    },
    {
     "x": 300,
     "y": 1080,
     "id": "n_intent_shift_confirm",
     "kind": "intent",
     "label": "Confirm shift",
     "config": {
      "prompt": "I have found alternative OYO properties nearby with similar amenities. Shall I proceed with shifting your booking?"
     }
    },
    {
     "x": 560,
     "y": 1080,
     "id": "n_api_shift",
     "kind": "api",
     "label": "Shift Booking API",
     "config": {
      "connection": "OYO Shift Booking"
     }
    },
    {
     "x": 820,
     "y": 1080,
     "id": "n_msg_shift_ok",
     "kind": "message",
     "label": "Shift done",
     "config": {
      "text": "Done! I've initiated the shift of your booking to a nearby OYO property with similar amenities. You'll receive the new property details on SMS and email shortly."
     }
    },
    {
     "x": 1080,
     "y": 1080,
     "id": "n_msg_shift_err",
     "kind": "message",
     "label": "Shift failed",
     "config": {
      "text": "I'm sorry, the shift could not be completed right now. Let me connect you to our support team to arrange it manually."
     }
    },
    {
     "x": 1340,
     "y": 1080,
     "id": "n_msg_shift_decline",
     "kind": "message",
     "label": "Shift declined",
     "config": {
      "text": "I understand. You may visit the property as planned, and if you face any issue during check-in, please contact OYO support right away. You can also choose to cancel this booking through OYO support."
     }
    },
    {
     "x": 40,
     "y": 1210,
     "id": "n_api_dispo",
     "kind": "api",
     "label": "CRM Disposition API",
     "config": {
      "connection": "OYO Call Disposition"
     }
    },
    {
     "x": 300,
     "y": 1210,
     "id": "n_end_main",
     "kind": "end",
     "label": "End call",
     "config": {
      "text": "Thank you for calling Oh-Yo. Have a great day!"
     }
