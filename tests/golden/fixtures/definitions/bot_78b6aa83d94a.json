     "from": "n_ask_bid",
     "label": "fallback"
    },
    {
     "id": "e_n_api_booking__n_intent_stock__3784",
     "to": "n_intent_stock",
     "from": "n_api_booking",
     "label": "success"
    },
    {
     "id": "e_n_api_booking__n_end_nores__9881",
