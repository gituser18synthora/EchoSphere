 "workflows": [
  {
   "id": "wf_9bb6c57ff978",
   "name": "OYO stock validation journey",
   "version": 5,
   "status": "approved",
   "nodes": [
    {
     "x": 40,
     "y": 40,
     "id": "n_start",
     "kind": "start",
     "label": "Call starts"
    },
    {
     "x": 300,
     "y": 40,
     "id": "n_ask_bid",
     "kind": "ask",
     "label": "Confirm booking ID",
     "config": {
      "pattern": "(?:BK[-\\s]?)?([0-9]{4,10})",
      "question": "Could you please confirm the booking ID that needs validation?",
      "variable": "booking_id",
      "entityType": "text"
     }
    },
    {
     "x": 560,
     "y": 40,
     "id": "n_api_booking",
     "kind": "api",
     "label": "Booking Details API",
     "config": {
      "connection": "OYO Booking Details"
     }
    },
    {
     "x": 820,
     "y": 40,
     "id": "n_intent_stock",
     "kind": "intent",
     "label": "Can it be honored?",
     "config": {
      "prompt": "The property has not confirmed this booking so far. Could you check whether this booking can be honored at check-in?"
     }
    },
    {
     "x": 1080,
     "y": 40,
     "id": "n_api_report_h",
     "kind": "api",
     "label": "Report: honoured",
     "config": {
      "connection": "OYO Stock Report Honored"
     }
    },
    {
     "x": 1340,
     "y": 40,
     "id": "n_api_report_nh",
     "kind": "api",
     "label": "Report: cannot confirm",
     "config": {
      "connection": "OYO Stock Report Not Honored"
     }
    },
    {
     "x": 40,
     "y": 170,
     "id": "n_end_ok",
     "kind": "end",
     "label": "End (validated)",
     "config": {
      "text": "Perfect, thank you for validating. We'll inform the guest that the booking stands confirmed. Have a good day!"
     }
    },
    {
     "x": 300,
     "y": 170,
     "id": "n_end_no",
     "kind": "end",
     "label": "End (not confirmed)",
     "config": {
      "text": "Understood. We'll proceed with offering the guest an alternate property. Thank you for checking."
     }
    },
    {
     "x": 560,
     "y": 170,
     "id": "n_end_nores",
     "kind": "end",
     "label": "End (no booking ref)",
     "config": {
      "text": "No problem — I'll route this validation through the dashboard instead. Thank you!"
     }
    }
   ],
   "edges": [
    {
     "id": "e_n_start__n_ask_bid",
     "to": "n_ask_bid",
     "from": "n_start"
    },
    {
