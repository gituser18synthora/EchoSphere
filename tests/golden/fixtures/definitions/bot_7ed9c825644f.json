   "version": 2,
   "status": "approved",
   "nodes": [
    {
     "x": 40,
     "y": 40,
     "id": "n_start",
     "kind": "start",
     "label": "Outbound call connected"
    },
    {
     "x": 40,
     "y": 150,
     "id": "n_history_ask",
     "kind": "intent",
     "label": "Rung 1: history_ask",
     "config": {
      "prompt": "Aapke profile par dikh raha hai ki aapne pehle kai baar loan time se repay kiya hai — aap mPokket ke ek achhe user rahe hain, aur main nahi chahta ki aapka yeh record kharab ho. System records ke hisaab se pehle bhi payment ke baare mein baat hui thi aur promise ke baad bhi payment receive nahi hui, aur aapki last payment ke baad se koi naya payment update nahi hua hai. Kya aap abhi payment complete karenge?"
     }
    },
    {
     "x": 40,
     "y": 260,
     "id": "n_funds",
     "kind": "intent",
     "label": "Rung 2: funds",
     "config": {
      "prompt": "Aap apni savings se, ya kisi friend ya family se arrange karke bhi payment kar sakte hain — isse aapko koi extra penalty nahi deni hogi. Kya aap payment ka intezaam kar sakte hain?"
     }
    },
    {
     "x": 40,
     "y": 370,
     "id": "n_penalty_long",
     "kind": "intent",
     "label": "Rung 3: penalty_long",
     "config": {
      "prompt": "Dekhiye, repayment date par payment na hone se penalty charges din-b-din badhte rehte hain, aur already kaafi extra amount lag chuka hai. Hum nahi chahte ki delay ki wajah se aapko aur extra charges dene paden — woh amount aap kisi aur zaroori kaam mein use kar sakte hain. Isliye request hai ki abhi hi payment complete kar dijiye. Kya aap abhi payment karenge?"
     }
    },
    {
     "x": 40,
     "y": 480,
     "id": "n_cibil_long",
     "kind": "intent",
     "label": "Rung 4: cibil_long",
     "config": {
      "prompt": "Time par repayment na karne se aapke CIBIL par bhi impact ho raha hai, aur aap jaante hain aaj ke time mein CIBIL kitna important hai. Ghar mein kabhi bhi medical ya koi emergency aa sakti hai jismein loan ki zarurat pad sakti hai. Agar CIBIL kharab rahega toh kisi bhi tarah ka loan lene mein dikkat hogi, aur mila bhi toh interest rate kaafi high hoga. EMI par koi saman lene mein bhi pareshani ho sakti hai. Hum nahi chahte ki aapko yeh dikkat ho, isliye request hai ki payment complete kar dijiye. Kya aap payment karenge?"
     }
    },
    {
     "x": 40,
     "y": 590,
     "id": "n_limit_block",
     "kind": "intent",
     "label": "Rung 5: limit_block",
     "config": {
      "prompt": "Agar aap time par payment nahi karte, toh aapka credit limit decrease ho sakta hai aur limit block hone ke bhi chances hain. Lekin sahi date par repayment karne se aapka credit limit gradually ₹50,000 tak increase ho sakta hai. Kya aap abhi payment complete karenge?"
     }
    },
    {
     "x": 40,
     "y": 700,
     "id": "n_notice",
     "kind": "intent",
     "label": "Rung 6: notice",
     "config": {
      "prompt": "Ek important baat — aapki profile par recovery notice ki soft copy active ho chuki hai, jo aapke liye theek nahi hai. Is situation ko avoid karne ke liye jaldi se payment complete kar dijiye. Kya aap abhi payment karenge?"
     }
    },
    {
     "x": 360,
     "y": 150,
     "id": "n_ptype",
     "kind": "ask",
     "label": "Full or partial payment",
     "config": {
      "question": "Bahut achha! Kya aap apna poora overdue amount pay karenge, ya partial payment karenge?",
      "synonyms": {
       "full": [
        "poora",
        "pura",
        "puri",
        "complete",
        "whole",
        "saara",
        "sara",
        "full",
        "पूरा",
        "पूरी",
        "सारा",
        "पूर्ण"
       ],
       "partial": [
        "partial",
        "part payment",
        "aadha",
        "adha",
        "half",
        "thoda",
        "installment",
        "instalment",
        "kisht",
        "आधा",
        "आधी",
        "थोड़ा",
        "थोड़ी",
        "किस्त",
        "किश्त"
       ]
      },
      "variable": "payment_type",
      "entityType": "list"
     }
    },
    {
     "x": 360,
     "y": 260,
     "id": "n_mop",
     "kind": "ask",
     "label": "Mode of payment",
     "config": {
      "question": "Kaunse madhyam se aapka payment hoga – Debit Card ya UPI?",
      "synonyms": {
       "UPI": [
        "upi",
        "bhim",
        "paytm",
        "gpay",
        "google pay",
        "phonepe",
        "phone pe",
        "qr",
        "यूपीआई",
        "यू पी आई",
        "भीम",
        "पेटीएम",
        "फोनपे",
        "फोन पे",
        "गूगल पे",
        "क्यूआर"
       ],
       "Debit Card": [
        "debit",
        "card",
        "atm",
        "डेबिट",
        "कार्ड",
        "एटीएम"
       ]
      },
      "variable": "payment_method",
      "entityType": "list"
     }
    },
    {
     "x": 360,
     "y": 370,
     "id": "n_guide",
     "kind": "message",
     "label": "Payment guidance",
     "config": {
      "text": "Dhanyavaad! Kripya mPokket app kholkar apna payment abhi complete kar dijiye. Payment complete hote hi aapka profile turant update ho jayega aur koi extra penalty charges nahi lagenge. Main call par kabhi card number, PIN ya OTP nahi maangta — yeh details kisi ke saath share na karein."
     }
    },
    {
     "x": 360,
     "y": 480,
     "id": "n_close",
     "kind": "end",
     "label": "Close call",
     "config": {
      "text": "mPokket mein samay dene ke liye dhanyavaad, aapka din shubh ho!"
     }
    },
    {
     "x": 40,
     "y": 810,
     "id": "n_refuse_end",
     "kind": "end",
     "label": "Refusal close",
     "config": {
      "text": "Theek hai, main aapki baat note kar raha hun. Lekin dhyaan rakhiye — aapki profile par recovery notice active hai, penalty roz badh rahi hai aur CIBIL par impact jaari hai. Kripya aaj hi mPokket app se payment complete kariye taaki situation aur na bigde. mPokket mein samay dene ke liye dhanyavaad, aapka din shubh ho!"
     }
    },
    {
     "x": 660,
     "y": 150,
     "id": "n_callback",
     "kind": "end",
     "label": "Callback close",
     "config": {
      "text": "Koi baat nahi, hum aapko baad mein call kar lenge. Kripya jitni jaldi ho sake mPokket app se apna payment complete kar dijiye, taaki koi extra charges na lagen. Dhanyavaad, aapka din shubh ho!"
     }
    },
    {
     "x": 660,
     "y": 260,
     "id": "n_wrong",
     "kind": "end",
     "label": "Wrong person close",
     "config": {
      "text": "Maaf kijiye, lagta hai yeh call galat number par lag gayi. Aapka samay lene ke liye khed hai. Dhanyavaad, aapka din shubh ho!"
     }
    },
    {
     "x": 660,
     "y": 370,
     "id": "n_paid",
     "kind": "handover",
     "label": "Already paid — verify",
     "config": {
      "text": "Agar aapne payment already complete kar di hai, toh dhanyavaad! Main aapko hamare agent se connect kar raha hun jo aapki payment verify kar denge. Kripya line par bane rahiye."
     }
    },
    {
     "x": 660,
     "y": 480,
     "id": "n_agent",
     "kind": "handover",
     "label": "Agent handover",
     "config": {
      "text": "Main aapko hamare ek agent se connect kar raha hun. Kripya line par bane rahiye."
     }
    }
