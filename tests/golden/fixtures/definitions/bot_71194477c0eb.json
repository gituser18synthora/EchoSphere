    {
     "x": 300,
     "y": 170,
     "id": "n_intent_agent_lookup",
     "kind": "intent",
     "label": "Offer agent (lookup failed)",
     "config": {
      "prompt": "Would you like me to connect you to a support executive who can help find your order?",
      "unmatchedReply": "I still haven't verified an order. Please share the exact seven-digit order ID or the ten-digit registered mobile number, or clearly say that you want a support executive.",
      "identifierCorrection": {
       "target": "n_api_lookup2",
